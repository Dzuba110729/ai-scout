DATABASE_URL=postgresql+psycopg://scout:scout@db:5432/ai_scout

BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=120

APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/website-content-crawler
APIFY_RUN_TIMEOUT_SECONDS=600

# Google Drive/Docs — отчёты об обходах. Два способа, приоритет у второго:
#
# 1) Личный аккаунт через OAuth (по умолчанию для теста) — документы попадают
#    прямо в ваш "Мой диск". Один раз: заполните путь к OAuth-клиенту (Google
#    Cloud Console -> Credentials -> OAuth client ID -> Desktop app) и
#    запустите `python scripts/google_oauth_login.py` — он сохранит токен по
#    пути GOOGLE_OAUTH_TOKEN_PATH, дальше он обновляется сам.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=
GOOGLE_OAUTH_TOKEN_PATH=google_oauth_token.json
#
# 2) Сервисный аккаунт (для продакшена/общей команды, если задан — используется
#    вместо OAuth выше). Файлы принадлежат робот-аккаунту, доступны по ссылке.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Интервал обхода по умолчанию — только для первого запуска (создания schedule_config).
# Дальше расписание меняется через UI и хранится в БД, эта переменная не перечитывается.
CRAWL_INTERVAL_DAYS=7
CRAWL_REQUEST_DELAY_SECONDS=2.0
CRAWL_MAX_PAGES=200

LOG_LEVEL=INFO
