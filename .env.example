DATABASE_URL=postgresql+psycopg://scout:scout@db:5432/ai_scout

BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=120

APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/website-content-crawler
APIFY_RUN_TIMEOUT_SECONDS=600

# Google Drive/Docs — отчёты об обходах. Два способа, приоритет у второго:
#
# 1) Личный аккаунт через OAuth (по умолчанию для теста) — документы попадают
#    прямо в ваш "Мой диск". Один раз: заполните путь к OAuth-клиенту (Google
#    Cloud Console -> Credentials -> OAuth client ID -> Desktop app) и
#    запустите `python scripts/google_oauth_login.py` — он сохранит токен по
#    пути GOOGLE_OAUTH_TOKEN_PATH, дальше он обновляется сам.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=
GOOGLE_OAUTH_TOKEN_PATH=google_oauth_token.json
#
# 2) Сервисный аккаунт (для продакшена/общей команды, если задан — используется
#    вместо OAuth выше). Файлы принадлежат робот-аккаунту, доступны по ссылке.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Интервал обхода по умолчанию — только для первого запуска (создания schedule_config).
# Дальше расписание меняется через UI и хранится в БД, эта переменная не перечитывается.
CRAWL_INTERVAL_DAYS=7
CRAWL_REQUEST_DELAY_SECONDS=2.0
CRAWL_MAX_PAGES=200

# Сколько конкурентов обходить одновременно. Каждый обход поднимает свой браузер,
# поэтому больше 3-4 на обычном сервере ставить не стоит.
CRAWL_CONCURRENCY=3

# Пропала страница из обхода — прежде чем объявить её удалённой, ходим по её
# адресу обычным запросом: 404 (удалена), перенаправление (переехала) или 200
# (жива, просто не попала в этот обход). Настройки этой перепроверки:
CRAWL_RECHECK_MAX_PAGES=100
CRAWL_RECHECK_CONCURRENCY=5
CRAWL_RECHECK_TIMEOUT_SECONDS=15.0

# Если обход оборвался (упал сервер, легла база) и страница уже была загружена не
# позже этого срока назад — при повторном запуске она берётся из черновика, а не
# грузится с сайта конкурента заново. Заодно по числу строк в черновике видно,
# сколько страниц уже обошли (счётчик в интерфейсе, пока обход идёт).
CRAWL_RESUME_MAX_AGE_HOURS=12.0

# Сравнение находок с нашим собственным сайтом («есть ли у нас такая страница»).
# Сам адрес нашего сайта задаётся в интерфейсе на странице «Настройки», не здесь.
#
# Сколько находок за один обход отправлять на сравнение с нашим сайтом. Каждое
# сравнение — отдельный запрос к ИИ, поэтому потолок нужен: если конкурент
# выложил 200 новых страниц, сравнивать все 200 и долго, и расточительно.
# Сначала сравниваются новые страницы, потом изменившиеся.
OWN_SITE_COMPARE_MAX_PER_RUN=10
# Сколько наших страниц показывать ИИ как возможные совпадения (подбираются
# автоматически по совпадению слов).
OWN_SITE_COMPARE_CANDIDATES=3
# Сколько символов текста каждой страницы отдавать ИИ.
OWN_SITE_COMPARE_TEXT_LIMIT=3000

LOG_LEVEL=INFO
